---
// For Investors. Live: a white band whose text column sits in the right half
// (the intro letters darken as they appear), a forest-green band listing four
// services in a row, a white band with the typed closing paragraph, then the CTA.
import { getImage } from 'astro:assets';
import Site from '../layouts/Site.astro';
import TypeReveal from '../components/site/TypeReveal.astro';
import ScrollDarken from '../components/site/ScrollDarken.astro';
import CtaBanner from '../components/site/CtaBanner.astro';
import { forInvestors } from '../data/forInvestors.ts';
import { image } from '../lib/images.ts';

// Live paints the left half of the intro band with this photo as a CSS
// background (no <img>), so it is resolved through getImage() rather than
// rendered with <Image>.
const photo = await getImage({ src: image('hazel-OhUURadmw-k-unsplash-scaled.jpg'), format: 'webp', width: 1600 });
const band = await getImage({ src: image('luca-bravo-YoelVcKWmws-unsplash-scaled.jpg'), format: 'webp', width: 2000 });
---
<Site title="For Investors">
  <h1 class="visually-hidden">For Investors</h1>

  <section class="inv-intro">
    <div class="inv-intro__photo" style={`background-image:url('${photo.src}')`} aria-hidden="true"></div>
    <div class="inv-intro__col">
      <p class="inv-intro__eyebrow">{forInvestors.eyebrow}</p>
      <ScrollDarken text={forInvestors.intro} class="inv-intro__text" />
    </div>
  </section>

  <section class="inv-list">
    <p class="inv-list__intro">{forInvestors.listIntro}</p>
    <ul class="inv-list__items" role="list">
      {forInvestors.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="inv-closing">
    <TypeReveal text={forInvestors.closing} />
  </section>

  {/* A full-bleed 810px photo band (500px on mobile) between the closing
      paragraph and the CTA. It carries no text — the photo IS the content. */}
  <div class="inv-band" style={`background-image:url('${band.src}')`} role="img" aria-label="Wind turbines on open farmland"></div>

  <CtaBanner />
</Site>

<style>
  /* Live's intro band is two 50% columns: the photo (a CSS background, not an
     <img>) on the left and the 494px text column centred in the right half.
     The band's height is content-driven — 721px at 1280 — not a fixed value. */
  .inv-intro {
    background: var(--c-white);
    display: flex;
    align-items: stretch;
  }
  .inv-intro__photo {
    flex: 0 0 50%;
    background-repeat: no-repeat;
    /* live: an 85%-wide crop offset off the left edge, held still while the
       page scrolls past it */
    background-size: 85% auto;
    background-position: -31vw -256px;
    background-attachment: fixed;
  }
  .inv-intro__col {
    flex: 0 0 50%;
    /* without this the 494px children set the flex item's min-content width
       and push the band past the viewport below ~1000px */
    min-width: 0;
    /* live: the text column carries 110px of bottom padding, and the widgets
       inside are a fixed 494px centred in the half */
    padding-block-end: 110px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    color: var(--c-ink-muted);
  }
  .inv-intro__col > * { width: 494px; max-width: 100%; }
  .inv-intro__eyebrow {
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    margin-block: 50px 10px;   /* live's eyebrow margins */
  }
  .inv-intro__text {
    font-size: var(--fs-intro);
    line-height: var(--lh-intro);
  }

  /* Below 1025 live drops the parallax and covers the column instead. */
  @media (max-width: 1024px) {
    .inv-intro__photo {
      background-attachment: scroll;
      background-size: cover;
      background-position: 70% 0;
    }
  }

  /* live @1280: forest green, 370 tall; lilac 25px lead-in, four 20px items in a row */
  /* Live: a full-bleed 370px band, contents vertically centred, no padding of
     its own. The lead-in is indented 2%; the items sit in a 90%-wide row. */
  .inv-list {
    background: var(--c-forest);
    color: var(--c-lilac);
    min-height: 370px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding: 0;
  }
  .inv-list__intro {
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    padding-inline-start: 2%;
  }
  /* live: a 90%-wide centred row, space-between, with the four items sized to
     their own text (flex: 0 1 auto) rather than to equal columns */
  .inv-list__items {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    width: 90%;
    margin-inline: auto;
    list-style: none;
    padding: 10px;   /* live's row padding — the items start 10px inside it */
  }
  .inv-list__items li { flex: 0 1 auto; font-size: 20px; line-height: 25px; }

  .inv-band {
    min-height: 810px;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  @media (max-width: 767px) { .inv-band { min-height: 500px; } }

  .inv-closing {
    background: var(--c-white);
    min-height: 370px;
    display: flex;
    align-items: center;
    padding: var(--space-2xl) var(--container-pad);
  }

  /* Live keeps the four items in a row down to 768 (--flex-wrap-mobile: wrap);
     they stack only on mobile. */
  @media (max-width: 767px) {
    .inv-list__items { flex-direction: column; gap: var(--space-md); }
  }
  /* At <=767 live stacks the band and sends the photo BELOW the text
     (--order: 99999), giving it a fixed 500px height. */
  @media (max-width: 767px) {
    .inv-intro { flex-direction: column; }
    .inv-intro__photo {
      order: 2;
      flex: none;
      min-height: 500px;
      background-position: 0 0;
    }
    .inv-intro__col {
      order: 1;
      flex: none;
      /* measured: live's eyebrow lands at y=101 here, 50px lower than its
         declared 50px padding alone would put it */
      padding: 100px 5px 70px;
    }
    .inv-list__items li { font-size: 16px; }
  }
</style>

