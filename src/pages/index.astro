---
import Site from '../layouts/Site.astro';
import Hero from '../components/home/Hero.astro';
import IntroStatement from '../components/home/IntroStatement.astro';
import ServiceAccordion from '../components/home/ServiceAccordion.astro';
import SectorStrip from '../components/home/SectorStrip.astro';
import StatCounters from '../components/home/StatCounters.astro';
import { siteMeta } from '../lib/site.ts';

const introText =
  'Maxwell Advisory helps capex-intensive climate businesses align projects with infrastructure investor requirements and run capital raises to secure long-term investment';
---
<Site
  title="Bridging climate companies and infrastructure investors"
  description={siteMeta.tagline}
  overlayHeader
  headerOnDark
>
  <Hero
    title="Bridging climate companies and infrastructure investors"
    tagline={siteMeta.tagline}
  />
  <IntroStatement text={introText} />
  <ServiceAccordion />
  <SectorStrip />
  <StatCounters />
</Site>
