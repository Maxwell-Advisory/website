---
// Contact. Live is a single full-width section split into two equal columns:
// a forest-green panel (#465845) on the left with its content bottom-aligned,
// and a wind-turbine photograph filling the right (background-size: cover,
// positioned 50% 100%). Copy is lilac (#e0e5fc). Below 768 the two stack, the
// copy centres, and the address drops to 24px.
import Site from '../layouts/Site.astro';
import { url } from '../lib/site.ts';

const photo = url('/wp-content/uploads/2025/12/usukhbayar-gankhuyag-mbVjn3eKVcI-unsplash-scaled.jpg');
---
<Site title="Contact">
  <!-- live has no heading on this page; a hidden one keeps the document
       outline valid without changing the visuals -->
  <h1 class="visually-hidden">Contact</h1>
  <section class="contact">
    <div class="contact__panel">
      <p
        class="contact__address"
        set:html="Maxwell Advisory&nbsp; Climate House<br />39 rue du Caire&nbsp; 75002 Paris, France"
      />
      <div class="contact__enquiry">
        <p class="contact__label">General Enquiries:</p>
        <a class="contact__btn shine" href="mailto:contact@maxwelladvisory.eu">
          contact@maxwelladvisory.eu
        </a>
      </div>
    </div>
    <div
      class="contact__photo"
      style={`background-image:url('${photo}')`}
      role="img"
      aria-label="Wind turbines at sunset"
    ></div>
  </section>
</Site>

<style>
  /* live @1280: section 1265x725, flex row, two 632px columns */
  .contact {
    display: flex;
    min-height: 725px;
  }
  .contact__panel {
    flex: 0 0 50%;
    background: var(--c-forest);      /* #465845 */
    color: var(--c-lilac);            /* #e0e5fc */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;        /* live bottom-aligns the content */
    padding: 0 0 50px 2%;
  }
  .contact__photo {
    flex: 0 0 50%;
    background-size: cover;
    background-position: 50% 100%;   /* live: bottom-centred */
    background-repeat: no-repeat;
  }

  /* live: the address block is held to 307px, which is what wraps it onto four
     lines; the label and the pill then sit side by side on one row (the button
     starts at x=142, exactly where the 117px label ends), 27px below. */
  .contact__address {
    width: 307px;
    max-width: 100%;
    font-size: 36px;
    line-height: 45px;
    font-weight: var(--fw-book);
  }
  .contact__enquiry {
    display: flex;
    align-items: center;
    margin-block-start: 27px;
  }
  .contact__label {
    flex: none;
    width: 117px;
    font-size: 13px;
    line-height: 19.5px;
  }
  /* same pill as the hero CTAs, in lilac */
  .contact__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    min-height: 36px;
    padding: 10px 50px;
    border: 1px solid var(--c-lilac);
    border-radius: 80px;
    background: #E0E5FC00;
    color: var(--c-lilac);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1;
    transition: all 0.8s;
  }
  .contact__btn:hover { color: var(--c-white); border-color: var(--c-white); }

  /* Live stacks the panel over the photo, centres the copy and drops the
     address to 24px, and centres the block vertically instead of bottom-aligning. */
  @media (max-width: 767px) {
    .contact { flex-direction: column; min-height: 0; }
    .contact__panel {
      flex: 1 1 auto;
      min-height: 55vh;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: var(--space-2xl) var(--container-pad);
    }
    .contact__photo { flex: 1 1 auto; min-height: 45vh; }
    .contact__address { width: auto; font-size: 24px; line-height: 30px; }
    /* live centres and stacks this block below 768 */
    .contact__enquiry { flex-direction: column; align-items: center; gap: var(--space-xs); }
    .contact__label { width: auto; }
  }
</style>
