---
import Base from '../layouts/Base.astro';
import head from '../chunks/team.head.html?raw';
import pre  from '../chunks/team.pre.html?raw';
import mid  from '../chunks/team.mid.html?raw';
import post from '../chunks/team.post.html?raw';
import { team, renderMember } from '../data/team';
// Team carousel slides are generated from src/data/team.ts (see <!--LOOP:team--> in the chunk).
const midHtml = mid.replace('<!--LOOP:team-->', team.map(renderMember).join(''));
---
<Base
  head={head}
  pre={pre}
  mid={midHtml}
  post={post}
  bodyClass="wp-singular page-template page-template-elementor_header_footer page page-id-737 wp-custom-logo wp-embed-responsive wp-theme-hello-elementor wp-child-theme-hello-theme-child-master cookies-not-set hello-elementor-default elementor-default elementor-template-full-width elementor-kit-6 elementor-page elementor-page-737"
/>
