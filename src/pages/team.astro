---
// Team. Live @1280: one row with 200px of top padding — a 434px left column
// (36px/45 tagline in #222 plus a large rotated motif) and an 806px right
// column holding a drag carousel of member cards, two visible at a time.
// Members come from src/data/team.ts.
import Site from '../layouts/Site.astro';
import { Image } from 'astro:assets';
import { team } from '../data/team.ts';
import { image } from '../lib/images.ts';

const tagline = 'Experienced investors and advisors dedicated to accelerating the energy transition.';
const motif = image('Calque_1.png');
---
<Site title="Team" headerDarkToggle>
  <h1 class="visually-hidden">Team</h1>

  <section class="team">
    <div class="team__intro">
      <p class="team__tagline">{tagline}</p>
      <Image class="team__motif" src={motif} alt="" aria-hidden="true" />
    </div>

    <div class="team__carousel" data-team-carousel>
      <ul class="team__track" data-team-track role="list">
        {team.map((m) => (
          <li class="member">
            {m.image ? (
              <Image
                class="member__photo"
                src={image(m.image)}
                widths={[364, 728]}
                sizes="(max-width: 767px) 90vw, 364px"
                alt={m.name}
                loading="lazy"
              />
            ) : (
              /* no portrait yet — a neutral block keeps the card's geometry */
              <div class="member__photo member__photo--placeholder" aria-hidden="true"></div>
            )}
            <h2 class="member__name">{m.name}</h2>
            <div class="member__meta">
              <p class="member__role">{m.role}</p>
              {m.linkedin && (
                <a
                  class="member__linkedin"
                  href={m.linkedin}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${m.name} on LinkedIn (opens in a new tab)`}
                  draggable="false"
                >
                  {/* LinkedIn "in" mark */}
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
                  </svg>
                </a>
              )}
            </div>
            <div class="member__bio">
              {(Array.isArray(m.bio) ? m.bio : [m.bio]).map((para) => <p>{para}</p>)}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Site>

<style>
  .team {
    display: flex;
    gap: 0;
    padding: 200px var(--container-pad) 0;   /* live: no bottom padding */
  }
  .team__intro {
    flex: 0 0 434px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .team__tagline {
    font-size: var(--fs-intro);     /* live: 36/45 */
    line-height: var(--lh-intro);
    color: var(--c-near-black);     /* live: #222222 */
  }
  /* Live declares this at 168px and SPINS it (animation: spin 3s linear
     infinite, the same treatment as the footer mark) — it is not a statically
     rotated image, which is why it measures a different bounding box on every
     capture. */
  .team__motif {
    width: 168px;
    height: auto;
    margin-block-start: auto;
    animation: team-motif-spin 3s linear infinite;
  }
  @keyframes team-motif-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .team__motif { animation: none; }
  }

  .team__carousel {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    padding: 10px;
    cursor: grab;
    touch-action: pan-y;
  }
  .team__carousel.is-dragging { cursor: grabbing; }
  .team__track {
    display: flex;
    gap: 20px;
    margin: 0;
    will-change: transform;
    user-select: none;
    /* How much of the next member shows past the right edge. The autoplay
       only says “there are more people here” once it moves; the sliver says
       it in the first still frame, and keeps saying it while a reader hovers
       and the autoplay is held. */
    --peek: 44px;
  }
  /* live showed two at a time with nothing past them; two plus the sliver
     means two gaps sit inside the viewport, not one */
  .member {
    flex: 0 0 calc((100% - 2 * 20px - var(--peek)) / 2);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .member__photo {
    width: 100%;
    height: var(--team-photo-h);
    object-fit: cover;
    /* Portraits rest in black and white and warm to full colour on hover.
       Gated on (hover: hover) so touch devices — which can never satisfy the
       hover — get the colour photograph rather than a permanently grey one. */
    transition: filter var(--dur) var(--ease);
  }
  @media (hover: hover) {
    .member__photo { filter: grayscale(1); }
    .member:hover .member__photo,
    .member:focus-within .member__photo { filter: grayscale(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .member__photo { transition: none; }
  }
  .member__photo--placeholder {
    background: var(--c-hairline);
    filter: none;
  }
  .member__name {
    font-size: var(--fs-eyebrow);   /* live: 25px/25 */
    line-height: 25px;
    color: var(--c-ink-muted);
  }
  /* Role and LinkedIn icon share one line, the icon after the role. */
  .member__meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .member__role { font-size: 13px; line-height: 19.5px; color: var(--c-ink-muted); }
  .member__linkedin {
    display: inline-flex;
    padding: 4px;          /* a larger target than the 18px mark itself */
    margin: -4px;
    color: var(--c-ink-muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .member__linkedin:hover,
  .member__linkedin:focus-visible { color: var(--c-near-black); }
  .member__linkedin svg { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .member__linkedin { transition: none; }
  }
  /* live insets the bio from the photo edge (335 wide in a 384 slide) */
  /* the card's own 20px gap is right between photo, name and role, but too
     loose between paragraphs of the same biography */
  .member__bio {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
    font-size: var(--team-bio-fs);
    line-height: 1.25;
    color: var(--c-ink-muted);
    max-width: 335px;
  }
  .member__bio p { margin: 0; }

  /* Live stacks the intro above the carousel at <=1024 and centres the motif,
     but keeps the carousel TWO-up down to 768 (measured 352px slides at 768). */
  /* Structural only: live stacks the intro above the carousel at <=1024 and
     centres the motif. The sizes travel with the tokens. */
  @media (max-width: 1024px) {
    .team { flex-direction: column; gap: var(--space-2xl); padding-top: var(--space-3xl); }
    .team__intro { flex: 1 1 auto; }
    .team__motif { margin-block-start: 0; align-self: center; }
  }
  /* Mobile: one full-bleed 390px-tall slide at a time, as live. */
  @media (max-width: 767px) {
    .team { padding-inline: 0; }
    .team__intro { padding-inline: var(--container-pad); }
    .team__carousel { padding: 0; }
    .team__track { gap: 18px; --peek: 40px; }
    .member { flex-basis: calc(100% - 18px - var(--peek)); }
    .member__name, .member__meta, .member__bio { padding-inline: var(--container-pad); }
  }
</style>

<script>
  // A continuous, circular drift rather than discrete slides: the track is
  // always moving, so the members off screen are never in doubt, and there is
  // no moment at which the carousel looks like a static pair of photographs.
  //
  // Circularity is the usual trick — the member list is repeated until it is
  // comfortably wider than the viewport, and the offset wraps at the width of
  // one set, so the seam never arrives.
  const vp = document.querySelector<HTMLElement>('[data-team-carousel]');
  const track = vp?.querySelector<HTMLElement>('[data-team-track]');

  if (vp && track && track.children.length) {
    const SPEED = 42;            // px per second
    const originals = [...track.children] as HTMLElement[];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const gap = () => parseFloat(getComputedStyle(track).columnGap || '20') || 20;
    /** width of one full pass of the real members, including the trailing gap */
    const setWidth = () =>
      originals.reduce((w, el) => w + el.getBoundingClientRect().width + gap(), 0);

    // Repeat the members until the track can cover the viewport twice over,
    // which is what lets the wrap happen off screen.
    const stock = () => {
      track.querySelectorAll('[data-clone]').forEach((el) => el.remove());
      let guard = 12;
      // offset wraps at one set width, so the track has to cover that plus a
      // full viewport for the seam to land off screen
      while (track.scrollWidth < setWidth() + vp.clientWidth + 1 && guard-- > 0) {
        for (const el of originals) {
          const c = el.cloneNode(true) as HTMLElement;
          c.dataset.clone = '';
          c.setAttribute('aria-hidden', 'true');   // the same people, said once
          // ...and tabbed through once: links inside a clone are not focusable
          c.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
          track.appendChild(c);
        }
      }
    };

    let offset = 0, held = false, hovering = false, onScreen = true, raf = 0, last = 0;

    const draw = (now: number) => {
      const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
      last = now;
      if (!held && !reduced.matches) offset += SPEED * dt;
      const w = setWidth();
      if (w > 0) offset = ((offset % w) + w) % w;   // wrap in both directions
      track.style.transform = `translateX(${-offset}px)`;
      raf = requestAnimationFrame(draw);
    };

    const run = (on: boolean) => {
      if (on && !raf) { last = 0; raf = requestAnimationFrame(draw); }
      if (!on && raf) { cancelAnimationFrame(raf); raf = 0; }
    };
    const sync = () => run(onScreen && !document.hidden);

    // --- drag still works, and simply moves the same offset ---------------
    // A press only becomes a drag once it has moved a few pixels. Until then it
    // is a click, so the LinkedIn links work; capturing the pointer on press
    // would send the click to the carousel instead of the link.
    const DRAG_START = 6;        // px of travel before a press counts as a drag
    let startX = 0, startOffset = 0, pressed = false, dragging = false, swallowClick = false;
    vp.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      pressed = true; held = true;   // hold still, so the target doesn't slide away
      startX = e.clientX; startOffset = offset;
    });
    vp.addEventListener('pointermove', (e) => {
      if (!pressed) return;
      const dx = e.clientX - startX;
      if (!dragging && Math.abs(dx) >= DRAG_START) {
        dragging = true;
        vp.setPointerCapture(e.pointerId);
        vp.classList.add('is-dragging');
      }
      if (dragging) offset = startOffset - dx;
    });
    const end = () => {
      if (!pressed) return;
      pressed = false;
      if (dragging) {
        dragging = false;
        swallowClick = true;           // a drag that ends on a link is not a click
        setTimeout(() => { swallowClick = false; }, 0);
        vp.classList.remove('is-dragging');
      }
      held = hovering;
    };
    vp.addEventListener('pointerup', end);
    vp.addEventListener('pointercancel', end);
    vp.addEventListener('click', (e) => {
      if (swallowClick) { e.preventDefault(); e.stopPropagation(); swallowClick = false; }
    }, true);
    vp.addEventListener('dragstart', (e) => e.preventDefault());

    // Hold while a reader is actually reading. Hover-hold only where hovering
    // exists: on touch, pointerenter fires on tap and its pointerleave may
    // never arrive, which would stall the drift for good.
    if (window.matchMedia('(hover: hover)').matches) {
      vp.addEventListener('pointerenter', () => { hovering = true; held = true; });
      vp.addEventListener('pointerleave', () => { hovering = false; if (!dragging) held = false; });
    }
    // Tabbing to a LinkedIn link holds the drift and brings that card into
    // view. The viewport clips rather than scrolls, so any scroll the browser
    // applies to reveal the focus is undone and expressed as offset instead.
    vp.addEventListener('focusin', (e) => {
      held = true;
      vp.scrollLeft = 0;
      const card = (e.target as HTMLElement).closest('.member');
      if (!card) return;
      const v = vp.getBoundingClientRect(), c = card.getBoundingClientRect();
      if (c.left < v.left || c.right > v.right) offset += c.left - v.left - 10;
    });
    vp.addEventListener('focusout', () => { held = hovering; });

    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver((es) => { onScreen = es[0].isIntersecting; sync(); },
      { threshold: 0 }).observe(vp);

    let pending = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(stock);
    }).observe(vp);

    // Photographs decide the card widths, so re-stock once they have landed.
    window.addEventListener('load', stock);
    stock();
    sync();
  }
</script>
