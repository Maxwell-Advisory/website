---
// Team. Live @1280: one row with 200px of top padding — a 434px left column
// (36px/45 tagline in #222 plus a large rotated motif) and an 806px right
// column holding a drag carousel of member cards, two visible at a time.
// Members come from src/data/team.ts.
import Site from '../layouts/Site.astro';
import { Image } from 'astro:assets';
import { team } from '../data/team.ts';
import { image } from '../lib/images.ts';

const tagline = 'Experienced investors and advisors dedicated to accelerating the energy transition.';
const motif = image('Calque_1.png');
---
<Site title="Team">
  <h1 class="visually-hidden">Team</h1>

  <section class="team">
    <div class="team__intro">
      <p class="team__tagline">{tagline}</p>
      <Image class="team__motif" src={motif} alt="" aria-hidden="true" />
    </div>

    <div class="team__carousel" data-team-carousel>
      <ul class="team__track" data-team-track role="list">
        {team.map((m) => (
          <li class="member">
            {m.image ? (
              <Image
                class="member__photo"
                src={image(m.image)}
                widths={[364, 728]}
                sizes="(max-width: 767px) 90vw, 364px"
                alt={m.name}
                loading="lazy"
              />
            ) : (
              /* no portrait yet — a neutral block keeps the card's geometry */
              <div class="member__photo member__photo--placeholder" aria-hidden="true"></div>
            )}
            <h2 class="member__name">{m.name}</h2>
            <p class="member__role">{m.role}</p>
            <p class="member__bio">{m.bio}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Site>

<style>
  .team {
    display: flex;
    gap: 0;
    padding: 200px var(--container-pad) 0;   /* live: no bottom padding */
  }
  .team__intro {
    flex: 0 0 434px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .team__tagline {
    font-size: var(--fs-intro);     /* live: 36/45 */
    line-height: var(--lh-intro);
    color: var(--c-near-black);     /* live: #222222 */
  }
  /* Live declares this at 168px and SPINS it (animation: spin 3s linear
     infinite, the same treatment as the footer mark) — it is not a statically
     rotated image, which is why it measures a different bounding box on every
     capture. */
  .team__motif {
    width: 168px;
    height: auto;
    margin-block-start: auto;
    animation: team-motif-spin 3s linear infinite;
  }
  @keyframes team-motif-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .team__motif { animation: none; }
  }

  .team__carousel {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    padding: 10px;
    cursor: grab;
    touch-action: pan-y;
  }
  .team__carousel.is-dragging { cursor: grabbing; }
  .team__track {
    display: flex;
    gap: 20px;
    margin: 0;
    will-change: transform;
    transition: transform var(--dur) var(--ease);
    user-select: none;
  }
  .member {
    flex: 0 0 calc((100% - 20px) / 2);   /* live shows two at a time */
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .member__photo {
    width: 100%;
    height: 500px;
    object-fit: cover;
    /* Portraits rest in black and white and warm to full colour on hover.
       Gated on (hover: hover) so touch devices — which can never satisfy the
       hover — get the colour photograph rather than a permanently grey one. */
    transition: filter var(--dur) var(--ease);
  }
  @media (hover: hover) {
    .member__photo { filter: grayscale(1); }
    .member:hover .member__photo,
    .member:focus-within .member__photo { filter: grayscale(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .member__photo { transition: none; }
  }
  .member__photo--placeholder {
    background: var(--c-hairline);
    filter: none;
  }
  .member__name {
    font-size: var(--fs-eyebrow);   /* live: 25px/25 */
    line-height: 25px;
    color: var(--c-ink-muted);
  }
  .member__role { font-size: 13px; line-height: 19.5px; color: var(--c-ink-muted); }
  /* live insets the bio from the photo edge (335 wide in a 384 slide) */
  .member__bio {
    font-size: 20px;
    line-height: 25px;
    color: var(--c-ink-muted);
    max-width: 335px;
  }

  /* Live stacks the intro above the carousel at <=1024 and centres the motif,
     but keeps the carousel TWO-up down to 768 (measured 352px slides at 768). */
  @media (max-width: 1024px) {
    .team { flex-direction: column; gap: var(--space-2xl); padding-top: var(--space-3xl); }
    .team__intro { flex: 1 1 auto; }
    .team__motif { margin-block-start: 0; align-self: center; }
    .member__bio { font-size: 18px; }
  }
  /* Mobile: one full-bleed 390px-tall slide at a time, as live. */
  @media (max-width: 767px) {
    .team { padding-inline: 0; }
    .team__intro { padding-inline: var(--container-pad); }
    .team__carousel { padding: 0; }
    .team__track { gap: 18px; }
    .member { flex-basis: 100%; }
    .member__photo { height: 390px; }
    .member__name, .member__role, .member__bio { padding-inline: var(--container-pad); }
  }
</style>

<script>
  // Pointer-drag carousel, same approach as the homepage sector strip.
  const vp = document.querySelector<HTMLElement>('[data-team-carousel]');
  const track = vp?.querySelector<HTMLElement>('[data-team-track]');
  if (vp && track) {
    const total = track.children.length;
    let index = 0, trackX = 0, startX = 0, dragging = false;
    const step = () => {
      const first = track.children[0] as HTMLElement;
      const gap = parseFloat(getComputedStyle(track).columnGap || '20') || 20;
      return first.getBoundingClientRect().width + gap;
    };
    const perView = () => Math.max(1, Math.round(vp.clientWidth / step()));
    const maxIndex = () => Math.max(0, total - perView());
    const goTo = (i: number) => {
      index = Math.max(0, Math.min(maxIndex(), i));
      trackX = -index * step();
      track.style.transform = `translateX(${trackX}px)`;
    };
    vp.addEventListener('pointerdown', (e) => {
      dragging = true; startX = e.clientX;
      vp.setPointerCapture(e.pointerId);
      vp.classList.add('is-dragging');
      track.style.transition = 'none';
    });
    vp.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      track.style.transform = `translateX(${trackX + (e.clientX - startX)}px)`;
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      vp.classList.remove('is-dragging');
      track.style.transition = '';
      const dx = e.clientX - startX;
      goTo(Math.abs(dx) > 40 ? index + Math.round(-dx / step()) : index);
    };
    vp.addEventListener('pointerup', end);
    vp.addEventListener('pointercancel', end);
    vp.addEventListener('dragstart', (e) => e.preventDefault());
    window.addEventListener('resize', () => goTo(index));

    // --- autoplay -------------------------------------------------------
    // The carousel holds more members than fit on screen, so it advances on
    // its own to make the off-screen ones evident. Three rules keep that from
    // becoming a nuisance:
    //   * it only starts once the carousel is actually on screen, so a visitor
    //     cannot scroll past during the pause before the first advance;
    //   * it stops while the reader is hovering, dragging, focused inside it,
    //     or on another browser tab;
    //   * it is skipped entirely under prefers-reduced-motion.
    const DELAY = 4000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;
    let held = false;      // pointer or focus is holding it
    let onScreen = false;

    const advance = () => goTo(index >= maxIndex() ? 0 : index + 1);
    const tick = () => { if (!held) advance(); };
    const sync = () => {
      const run = onScreen && !held && !document.hidden && !reduced.matches
        && maxIndex() > 0;
      if (run && timer === undefined) timer = window.setInterval(tick, DELAY);
      if (!run && timer !== undefined) { clearInterval(timer); timer = undefined; }
    };
    const hold = (v: boolean) => { held = v; sync(); };

    new IntersectionObserver((entries) => {
      onScreen = entries[0].isIntersecting;
      sync();
    }, { threshold: 0.4 }).observe(vp);

    // Hover-hold only where hovering exists: on touch, `pointerenter` fires on
    // tap and its matching `pointerleave` may never arrive, which would stall
    // the autoplay for good. Touch drags are covered by the drag hold below.
    if (window.matchMedia('(hover: hover)').matches) {
      vp.addEventListener('pointerenter', () => hold(true));
      vp.addEventListener('pointerleave', () => hold(false));
    }
    vp.addEventListener('pointerdown', () => hold(true));
    vp.addEventListener('pointerup', () => hold(false));
    vp.addEventListener('pointercancel', () => hold(false));
    vp.addEventListener('focusin', () => hold(true));
    vp.addEventListener('focusout', () => hold(false));
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    window.addEventListener('resize', sync);
  }
</script>
