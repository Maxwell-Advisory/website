---
// For Companies. Live: lilac intro band, then two blocks (heading, image,
// read-more copy) side by side down to 768 and stacked only on mobile, then
// the oversized "get in touch" CTA.
import Site from '../layouts/Site.astro';
import PageIntro from '../components/site/PageIntro.astro';
import ReadMore from '../components/site/ReadMore.astro';
import CtaBanner from '../components/site/CtaBanner.astro';
import { Image } from 'astro:assets';
import { forCompanies } from '../data/forCompanies.ts';
import { image } from '../lib/images.ts';
---
<Site title="For Companies">
  <h1 class="visually-hidden">For Companies</h1>
  <PageIntro eyebrow={forCompanies.eyebrow} intro={forCompanies.intro} />

  <section class="blocks">
    {forCompanies.blocks.map((b) => (
      <article class="block">
        <h2 class="block__heading">{b.heading}</h2>
        <Image class="block__image" src={image(b.image)} widths={[604, 1208]} sizes="(max-width: 1024px) 96vw, 604px" alt={b.alt} loading="lazy" />
        <ReadMore visible={b.visible} hidden={b.hidden} />
      </article>
    ))}
  </section>

  <CtaBanner />
</Site>

<style>
  /* live @1280: the two blocks sit side by side inside a 2% padded row,
     each 604px wide with a 20px column gap; below 1024 they stack. */
  .blocks {
    display: flex;
    gap: 20px;
    /* live: the block row is 763 tall and its headings sit 70px below the
       lilac band; no bottom padding (the CTA section supplies that) */
    padding: 104px 2% 0;
  }
  .block {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .block__heading {
    font-size: var(--fs-eyebrow);   /* live: 25px, uppercase, grey */
    line-height: 25px;
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }
  .block__image {
    width: 100%;
    height: 500px;                  /* live: 500px at 1280, 450 below */
    object-fit: cover;
  }
  /* Live shortens the images at <=1024 but keeps the two blocks SIDE BY SIDE
     down to 768 — they stack only on mobile. */
  @media (max-width: 1024px) {
    .block__image { height: 450px; }
  }
  @media (max-width: 767px) {
    .blocks { flex-direction: column; gap: 55px; padding-inline: 5px; }  /* live's measured stack gap */
  }
</style>
