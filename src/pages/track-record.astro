---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import head from '../chunks/track-record.head.html?raw';
import pre  from '../chunks/track-record.pre.html?raw';
import mid  from '../chunks/track-record.mid.html?raw';
import post from '../chunks/track-record.post.html?raw';
import { trackRecord, renderTrackItem } from '../data/trackRecord';
const B = import.meta.env.BASE_URL;
const sub = (s) => s.replaceAll('__BASE__/', B);
// Track-record entries (grid cards + popups) are generated from src/data/trackRecord.ts.
const midHtml = sub(mid.replace('<!--LOOP:trackrecord-->', trackRecord.map(renderTrackItem).join('')));
---
<!doctype html>
<html lang="fr-FR">
<head><Fragment set:html={sub(head)} /></head>
<body class="wp-singular page-template page-template-elementor_header_footer page page-id-898 wp-custom-logo wp-embed-responsive wp-theme-hello-elementor wp-child-theme-hello-theme-child-master cookies-not-set hello-elementor-default elementor-default elementor-template-full-width elementor-kit-6 elementor-page elementor-page-898">
<Fragment set:html={sub(pre)} />
<Header />
<Fragment set:html={midHtml} />
<Footer />
<Fragment set:html={sub(post)} />
</body>
</html>
