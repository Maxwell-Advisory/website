---
// Track Record. Live @1280: a slate intro band (#686d84, white 36/45 copy), an
// "Experience" label, then a two-column grid of entries. Each entry is a 70px
// uppercase title plus a short description with a +/- mark.
//
// Live opened a modal over a dimmed page. Here the card expands in place
// instead: it widens to span the row and grows to fit its own copy, and the
// cards below slide down to make room. See the script at the foot of the file
// for how the motion is done.
import Site from '../layouts/Site.astro';
import { Image } from 'astro:assets';
import { trackRecord } from '../data/trackRecord.ts';
import { image } from '../lib/images.ts';
---
<Site title="Track Record" headerLightMark>
  <h1 class="visually-hidden">Track Record</h1>

  <section class="tr-intro">
    <p class="tr-intro__text">
      Maxwell Advisory and its team have advised or executed more than 70
      transactions across the energy transition, infrastructure, and industrial
      sectors. Below is a selection of our experience.
    </p>
  </section>

  <section class="tr-body">
    <h2 class="tr-body__label">Experience</h2>
    <ul class="tr-grid" role="list">
      {trackRecord.map((entry) => (
        <li class="tr-item">
          <button class="tr-item__btn" type="button" data-tr-toggle aria-expanded="false">
            <span class="tr-item__row">
              <span class="tr-item__title">{entry.title}</span>
              <span class="tr-item__icon" aria-hidden="true"></span>
            </span>
            <span class="tr-item__desc" set:html={entry.description} />
            {entry.logo && (
              <Image class="tr-item__logo" src={image(entry.logo.src)} alt="" loading="lazy" />
            )}
          </button>
        </li>
      ))}
    </ul>
  </section>

</Site>

<style>
  /* live: 1265x525, background #686d84, padding 100px 0 110px, white 36/45 */
  .tr-intro {
    background: var(--c-slate);
    color: var(--c-white);
    /* live holds the band at a 525px min-height (420 at <=767) and centres the
       copy in it — without this the band collapses onto its padding and every
       card below sits ~110px too high */
    min-height: var(--tr-intro-h);
    display: flex;
    align-items: center;
    padding: 100px var(--container-pad) 110px;
  }
  .tr-intro__text {
    width: 967px;
    max-width: 100%;
    margin-inline: auto;     /* live centres the column ... */
    text-align: center;      /* ... and the text inside it */
    font-size: var(--fs-intro);
    line-height: var(--lh-intro);
  }

  /* live: 70px above the EXPERIENCE label (50 on mobile), nothing below the
     grid — the footer follows straight on. Grid is 1214 wide at x25. */
  .tr-body { padding: 70px 2% 0; }
  /* the motion Joe picked: span the row, 900ms, the site's own --ease */
  .tr-grid { --tr-dur: 900ms; }
  .tr-body__label {
    font-size: var(--fs-eyebrow);   /* live: 25px/25 grey, uppercase */
    line-height: 25px;
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }

  /* live: two columns, 30px row gap / 15px column gap, items 600x436 */
  .tr-grid {
    margin: 20px 0 0;   /* live: 20px below the EXPERIENCE label */
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr;   /* live's entries are all exactly the same height */
    gap: 30px 15px;
  }
  .tr-item {
    /* live: every entry is a 1px #333 box, 600x436, padded 28px */
    border: 1px solid var(--c-ink);
    /* grid items default to min-width:auto, so a long word in the 70px title
       can push the column wider than its track — this pins it */
    min-width: 0;
    overflow: hidden;   /* a closed card clips the copy it cannot yet show */
  }

  /* --- the expansion ---
     Without JS the grid above is the whole story: four boxes, each showing a
     four-line excerpt. The engine then adds .is-flip, takes the cards out of
     flow and drives their geometry itself, which is what lets a card widen
     and its neighbours slide out of the way in one continuous movement. */
  .tr-grid.is-flip {
    position: relative;
    display: block;
    transition: height var(--tr-dur) var(--ease);
  }
  .tr-grid.is-flip .tr-item {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    transition:
      transform var(--tr-dur) var(--ease),
      width     var(--tr-dur) var(--ease),
      height    var(--tr-dur) var(--ease);
    will-change: transform, width, height;
  }
  .tr-grid.is-flip .tr-item__btn { min-height: 0; height: 100%; }
  /* an open card shows all of its copy instead of the four-line excerpt */
  .tr-item.is-open .tr-item__desc { -webkit-line-clamp: unset; overflow: visible; }
  .tr-item.is-open .tr-item__title { color: var(--c-ink); }
  /* the +/- becomes an × on the way open, on the same curve as the box */
  .tr-item__icon { transition: transform var(--tr-dur) var(--ease); }
  .tr-item.is-open .tr-item__icon { transform: rotate(45deg); }

  @media (prefers-reduced-motion: reduce) {
    .tr-grid.is-flip,
    .tr-grid.is-flip .tr-item,
    .tr-item__icon { transition: none; }
  }
  .tr-item__btn {
    width: 100%;
    min-height: var(--tr-card-h);
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-lg);
    background: none;
    border: 0;
    text-align: start;
    cursor: pointer;
    color: var(--c-ink-muted);
  }
  /* title and the +/- share the top row; the logo sits bottom-right */
  .tr-item__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
  }
  .tr-item__title {
    font-size: var(--tr-title-fs);   /* live: 70/28/25 — now continuous */
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: break-word;      /* long words must not widen the card */
    color: var(--c-ink-muted);      /* live: #787575 at rest */
    transition: color var(--dur-fast) var(--ease);
  }
  .tr-item__btn:hover .tr-item__title { color: var(--c-ink); }
  /* Live truncates the card copy at runtime (its script inserts t1/t2/dots
     spans) to exactly four 25px lines. A line clamp gives the same result
     without the script. */
  .tr-item__desc {
    font-size: var(--readmore-fs);
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* live: 150px, right-aligned (text-align:end), sitting at the card's foot */
  .tr-item__logo {
    width: 150px;
    height: auto;
    align-self: flex-end;
    margin-block-start: auto;
  }
  /* open, the box is sized to its copy, so the logo sits under the text
     rather than being pushed to the foot of a tall empty box */
  .tr-item.is-open .tr-item__logo { margin-block-start: var(--space-md); }
  .tr-item__desc :global(p) { margin-block-end: 0.75em; }
  .tr-item__desc :global(p:last-child) { margin-block-end: 0; }

  /* the same +/- mark as the service accordion, at live's 50px */
  .tr-item__icon {
    flex: none;
    position: relative;
    width: 50px;
    height: 50px;
  }
  .tr-item__icon::before,
  .tr-item__icon::after {
    content: "";
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 50px;
    height: 2px;
    background: grey;
    border-radius: 2px;
  }
  .tr-item__icon::after { transform: rotate(90deg); }

  /* Structural only — live keeps two columns down to 768 and goes to one
     below it. Every size here now travels with the tokens instead. */
  @media (max-width: 767px) {
    .tr-grid { grid-template-columns: 1fr; }
    .tr-body { padding: 50px 2% 0; }
  }
</style>

<script>
  // "Span the row": the clicked card widens to the full grid width and grows
  // to fit its own copy; its row-mate is displaced onto the row below and
  // everything under it slides down.
  //
  // The grid cannot animate that on its own — grid-column and grid-row jump —
  // so once this runs the cards come out of flow and their geometry is set
  // here instead. CSS still carries the motion, on the duration and easing
  // declared in the stylesheet. Without JS the plain grid above stands.
  const grid = document.querySelector<HTMLElement>('.tr-grid');
  const items = grid ? [...grid.querySelectorAll<HTMLElement>('.tr-item')] : [];

  if (grid && items.length) {
    const GAP_X = 15, GAP_Y = 30;
    let open: number | null = null;

    const cols = () => (window.matchMedia('(max-width: 767px)').matches ? 1 : 2);

    // The closed height is a fluid token now, so it cannot be looked up from a
    // breakpoint. This probe carries the same token and is measured instead,
    // which keeps the engine correct at every width without repeating the
    // clamp in two places.
    const probe = document.createElement('div');
    probe.setAttribute('aria-hidden', 'true');
    probe.style.cssText =
      'position:absolute;visibility:hidden;pointer-events:none;width:0;height:var(--tr-card-h);';
    grid.appendChild(probe);
    const closedH = () => probe.offsetHeight;

    /** Height the open card needs for its copy at the width it will have.
        Measured on a hidden clone: resizing the real card to read it back
        restarted its transition mid-flight, which is what made the expansion
        snap instead of travel. */
    const measure = (el: HTMLElement, w: number) => {
      const clone = el.cloneNode(true) as HTMLElement;
      clone.classList.add('is-open');
      clone.style.cssText =
        `position:absolute;left:0;top:0;width:${w}px;height:auto;` +
        'visibility:hidden;pointer-events:none;transition:none;';
      grid.appendChild(clone);
      const h = clone.offsetHeight;
      clone.remove();
      return h;
    };

    const apply = (animate = true) => {
      const n = cols();
      const W = grid.clientWidth;
      const colW = (W - GAP_X * (n - 1)) / n;
      const base = closedH();

      const openH = open === null
        ? base
        : Math.max(base, measure(items[open], colW * n + GAP_X * (n - 1)));

      // Order the cards so the open one leads the row it already sat in. A
      // right-hand card that simply widened in place would wrap to the row
      // below and appear to jump; leading its row instead keeps it where it
      // was and pushes its left-hand neighbour down, which is what the
      // movement reads as.
      const seq: number[] = [];
      for (let r = 0; r * n < items.length; r++) {
        const inRow: number[] = [];
        for (let k = 0; k < n && r * n + k < items.length; k++) inRow.push(r * n + k);
        if (open !== null && inRow.includes(open)) {
          seq.push(open, ...inRow.filter((i) => i !== open));
        } else {
          seq.push(...inRow);
        }
      }

      // pack left to right, the open card taking every column in its row
      const rows: { i: number; span: number; h: number }[][] = [];
      let row: { i: number; span: number; h: number }[] = [], used = 0;
      seq.forEach((i) => {
        const span = i === open ? n : 1;
        if (used + span > n) { rows.push(row); row = []; used = 0; }
        row.push({ i, span, h: i === open ? openH : base });
        used += span;
      });
      if (row.length) rows.push(row);

      if (!animate) grid.style.setProperty('--tr-dur', '0ms');

      let y = 0;
      for (const r of rows) {
        const h = Math.max(...r.map((it) => it.h));
        let x = 0;
        for (const it of r) {
          const w = colW * it.span + GAP_X * (it.span - 1);
          const el = items[it.i];
          el.style.transform = `translate(${x}px, ${y}px)`;
          el.style.width = `${w}px`;
          el.style.height = `${h}px`;
          el.style.zIndex = it.i === open ? '2' : '1';
          x += w + GAP_X;
        }
        y += h + GAP_Y;
      }
      grid.style.height = `${Math.max(0, y - GAP_Y)}px`;

      if (!animate) {
        void grid.offsetHeight;
        grid.style.removeProperty('--tr-dur');
      }
    };

    items.forEach((el, i) => {
      const btn = el.querySelector<HTMLButtonElement>('.tr-item__btn');
      btn?.addEventListener('click', () => {
        open = open === i ? null : i;
        items.forEach((li, n) => {
          const isOpen = n === open;
          li.classList.toggle('is-open', isOpen);
          li.querySelector('.tr-item__btn')?.setAttribute('aria-expanded', String(isOpen));
        });
        apply();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || open === null) return;
      items[open].querySelector<HTMLButtonElement>('.tr-item__btn')?.click();
    });

    // Fonts land after first paint and change how the copy wraps, so an open
    // card measured before then would be the wrong height.
    document.fonts?.ready.then(() => apply(false));

    let pending = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(() => apply(false));
    }).observe(grid);

    grid.classList.add('is-flip');
    apply(false);
  }
</script>
