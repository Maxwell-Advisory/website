---
// Sector pages. Content-free on live (title only) — see src/data/stubPages.ts.
import Site from '../../layouts/Site.astro';
import PageTitle from '../../components/site/PageTitle.astro';
import { sectorPages } from '../../data/stubPages.ts';

export function getStaticPaths() {
  return sectorPages.map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props;
---
<Site title={page.title}>
  <PageTitle title={page.title} />
</Site>
