---
// Shared page scaffold for every page.
// A page supplies its four HTML chunks (head/pre/mid/post) and its <body> class;
// this layout owns the doctype/<html>/<head>/<body> structure, the Header and
// Footer, and the __BASE__ URL substitution (so it lives in one place).
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  head: string;
  pre: string;
  mid: string;
  post: string;
  bodyClass: string;
  lang?: string;
}

const { head, pre, mid, post, bodyClass, lang = 'fr-FR' } = Astro.props;
const B = import.meta.env.BASE_URL;
const sub = (s: string) => s.replaceAll('__BASE__/', B);

// --- Step E: strip the jQuery/Elementor runtime -----------------------------
// Every behaviour these scripts provided has been reimplemented in vanilla JS
// (carousels, .elementor-invisible reveal, counters, accordion, nav popup,
// footer motion-fx — see Footer.astro and the homepage accordion script). We
// remove the scripts here, in one place, rather than editing all 17 scraped
// chunks. Kept: cookie-notice (vanilla), the JSON-LD/schema blocks, Swiper
// (loaded on demand by Footer.astro), and our own scripts.
// To restore Elementor, delete this block and the stripRuntime() calls below.
const RUNTIME_SRC = [
  'wp-includes/js/jquery/jquery.min.js',
  'wp-includes/js/jquery/jquery-migrate.min.js',
  'wp-includes/js/jquery/ui/core.min.js',
  'themes/hello-elementor/assets/js/hello-frontend.js',
  'plugins/elementor/assets/js/webpack.runtime.min.js',
  'plugins/elementor/assets/js/frontend-modules.min.js',
  'plugins/elementor/assets/js/frontend.min.js',
  'plugins/elementor-pro/assets/lib/smartmenus/jquery.smartmenus.min.js',
  'wp-includes/js/imagesloaded.min.js',
  'plugins/elementor/assets/lib/jquery-numerator/jquery-numerator.min.js',
  'plugins/elementor-pro/assets/js/webpack-pro.runtime.min.js',
  'wp-includes/js/dist/hooks.min.js',
  'wp-includes/js/dist/i18n.min.js',
  'plugins/elementor-pro/assets/js/frontend.min.js',
  'plugins/elementor-pro/assets/js/elements-handlers.min.js',
];
const RUNTIME_INLINE_IDS = [
  'elementor-frontend-js-before',
  'wp-i18n-js-after',
  'elementor-pro-frontend-js-before',
];
const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
function stripRuntime(html: string): string {
  for (const p of RUNTIME_SRC) {
    const re = new RegExp(
      '[ \\t]*<script\\b[^>]*\\bsrc="[^"]*' + escapeRe(p) + '[^"]*"[^>]*>\\s*</script>\\s*\\n?',
      'g',
    );
    html = html.replace(re, '');
  }
  for (const id of RUNTIME_INLINE_IDS) {
    const re = new RegExp(
      '[ \\t]*<script\\b[^>]*\\bid="' + escapeRe(id) + '"[^>]*>[\\s\\S]*?</script>\\s*\\n?',
      'g',
    );
    html = html.replace(re, '');
  }
  return html;
}
const render = (s: string) => sub(stripRuntime(s));

// Preload the brand font weights the pages actually use (PP Neue Montreal Book
// = 400 for body text, Medium = 500). @font-face uses font-display:auto, so
// until the file arrives the browser paints the lighter system fallback — on a
// cold cache (e.g. the Pages site) that FOUT makes text look thinner than the
// original. Preloading fetches them before first paint so the brand font is
// used immediately. Fonts are always fetched in CORS mode, hence crossorigin.
const FONT_PRELOADS = [
  'wp-content/uploads/2025/12/ppneuemontreal-book.woff',
  'wp-content/uploads/2025/12/ppneuemontreal-medium-1.woff',
];
---
<!doctype html>
<html lang={lang}>
<head>
{FONT_PRELOADS.map((f) => (
  <link rel="preload" as="font" type="font/woff" crossorigin href={B + f} />
))}
<Fragment set:html={render(head)} /></head>
<body class={bodyClass}>
<Fragment set:html={render(pre)} />
<Header />
<Fragment set:html={render(mid)} />
<Footer />
<Fragment set:html={render(post)} />
</body>
</html>
