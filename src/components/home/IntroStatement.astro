---
// Lilac intro/mission band below the hero. The statement fills from grey to
// near-black character by character — see components/site/ScrollDarken.astro,
// which the For Investors intro also used before that page was removed.
import ScrollDarken from '../site/ScrollDarken.astro';
interface Props {
  text: string;
}
const { text } = Astro.props;
---
<section class="intro">
  <div class="intro__inner">
    <ScrollDarken text={text} class="intro__text" />
  </div>
</section>

<style>
  /* Live: min-height 370px (300px mobile), content vertically centred. */
  .intro {
    background: var(--c-lilac);
    min-height: var(--intro-min-h);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-lg);
  }
  /* Live gives the band only a 3px side padding on mobile — no container gutter. */
  .intro__inner { padding-inline: 3px; }
  .intro__text {
    max-width: var(--intro-text-w);   /* live: 1100px, 100% on mobile */
    margin-inline: auto;
    text-align: center;
    font-weight: var(--fw-book);
    color: var(--c-ink-muted);        /* base colour before the scroll-darken */
    font-size: var(--fs-intro);       /* 36 / 32 / 24px per live's tiers */
    line-height: var(--lh-intro);     /* 45 / 40 / 30px                  */
  }
  @media (max-width: 767px) {
    .intro__text { max-width: 100%; margin-block-start: 10px; }
  }
</style>

