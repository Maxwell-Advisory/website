---
// "Our data" — oversized counters that animate from 0 on scroll into view.
// Data: src/data/stats.ts. Numbers render at the display size from the design.
import { stats } from '../../data/stats.ts';
---
<section class="stats section" aria-label="Our data">
  <p class="eyebrow">Our data</p>
  <div class="stats__lines" data-stats-lines>
  <div class="container">
    <dl class="stats__grid">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat__label">{s.label}</dt>
          <dd class="stat__value">
            {s.prefix ?? ''}<span
              class="stat__number"
              data-count-to={s.value}
            >0</span>{s.suffix && <span class="stat__suffix">{s.suffix}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
  </div>
</section>

<style>
  /* Live: stats section has zero padding; the "Our data" eyebrow carries a
     75px top margin and a -20px bottom margin. */
  .stats { padding-block: 0; }
  /* measured live gaps: progress-bar bottom -> eyebrow top = 40px,
     eyebrow bottom -> counter top = 125px */
  .stats .eyebrow { margin-block-start: 40px; }

  /* Live (.stats-section) draws TWO 1px #787575 lines on the counters box:
     ::before at the top growing from the LEFT, ::after at the bottom growing
     from the RIGHT. Both are scroll-driven via --line-p. */
  .stats__lines {
    position: relative;
    overflow: visible;
  }
  .stats__lines::before,
  .stats__lines::after {
    content: "";
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--c-ink-muted);
    transform: scaleX(var(--line-p, 0));
    transition: transform 0.1s linear;
  }
  .stats__lines::before { top: 0; transform-origin: left center; }
  .stats__lines::after  { bottom: 0; transform-origin: right center; }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl) var(--space-lg);
    max-width: var(--container);   /* numbers stay in a centred ~1140 band */
    margin-inline: auto;
    margin-block-start: 125px;     /* measured live gap: eyebrow -> counter = 125px */
  }
  .stat {
    display: flex;
    flex-direction: column-reverse; /* number on top, label below — matches live */
    align-items: center;
    text-align: center;
    gap: 0;                 /* live has no gap between number and label */
  }
  /* Live counter tiers: number 160 / 60 / 120px, suffix 70 / 53 / 35px,
     label 20 / 20 / 14px — note mobile's number is LARGER than tablet's. */
  .stat__value {
    font-size: var(--fs-counter);
    /* Pin the box to exactly the font-size (as live) so the raised "+" cannot
       inflate it; the suffix overflows visibly. */
    height: var(--fs-counter);
    line-height: var(--fs-counter);
    letter-spacing: var(--tracking-tight);
    color: var(--c-ink-muted);
    margin: 0;
  }
  .stat__value .stat__number {
    color: inherit;
    text-transform: uppercase;
    /* inline-block + explicit leading so the span's box is exactly the
       font-size tall (an inline span's box would be the font's content area,
       ~197px at 160px, which is not what live renders). */
    display: inline-block;
    line-height: var(--fs-counter);
  }
  .stat__suffix {
    font-size: var(--fs-counter-suffix);
    margin-left: 15px;   /* live's custom CSS on the suffix */
    margin-top: 5px;
    /* Raised with position (not vertical-align: super) so the "+" does not
       inflate the line box — live's number box is exactly its font-size tall. */
    position: relative;
    top: -0.6em;
    line-height: 0;
  }
  /* live: .elementor-element-55b4384 title margin-left:-55px (>=768),
     .elementor-element-86a0f45 title margin-left:-25px */
  @media (min-width: 768px) {
    .stats__grid .stat:nth-child(1) { --stat-label-shift: -55px; }
  }
  .stats__grid .stat:nth-child(2) { --stat-label-shift: -25px; }

  .stat__label {
    font-size: var(--fs-counter-label);
    line-height: var(--lh-counter-label);   /* live: 50px desktop, 35px mobile */
    color: var(--c-ink-muted);
    text-align: start;      /* centred by the flex column, as on live */
    width: fit-content;
    /* live nudges the first two labels left by -55px / -25px */
    margin-left: var(--stat-label-shift, 0);     /* shrink to the text, like live (not full column) */
  }
  /* Below 1024 the measured eyebrow -> counter gap is smaller than desktop's
     125px, so the grid offset steps down (tuned against live: 125 at 768,
     285 at 375). */
  @media (max-width: 1023px) {
    .stats__grid { margin-block-start: 75px; }
  }
  @media (max-width: 767px) {
    .stats__grid { margin-block-start: 66px; }
  }

  /* live keeps all three counters in one row down to 768; it stacks only
     at <=767 (measured: same top at 768, ~205px apart at 375). */
  @media (max-width: 767px) {
    .stats__grid { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
</style>

<script>
  const nums = document.querySelectorAll<HTMLElement>('.stat__number');
  const run = (el: HTMLElement) => {
    const to = Number(el.dataset.countTo || '0');
    const dur = 1800;
    const start = performance.now();
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur);
      el.textContent = String(Math.round(ease(p) * to));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) {
    nums.forEach((el) => { el.textContent = el.dataset.countTo || '0'; });
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); }
      });
    }, { threshold: 0.6 });
    nums.forEach((el) => io.observe(el));
  }

  // The two hairlines on the counters box extend as the section scrolls through
  // view — top from the left, bottom from the right (live's .stats-section).
  const lines = document.querySelector<HTMLElement>('[data-stats-lines]');
  if (lines) {
    if (reduce) {
      lines.style.setProperty('--line-p', '1');
    } else {
      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = lines.getBoundingClientRect();
        const vh = window.innerHeight;
        // 0 when the box top sits at 90% of the viewport, 1 by 45%.
        const prog = (0.9 * vh - rect.top) / (0.45 * vh);
        lines.style.setProperty('--line-p', String(Math.max(0, Math.min(1, prog))));
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
