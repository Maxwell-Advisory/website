---
// Structured data for the homepage: who the firm is (Organization) and what
// the site is called (WebSite). It helps search engines show "Maxwell Advisory"
// as the site name and tell the firm apart from other organisations called
// Maxwell. Details come from siteMeta in src/lib/site.ts and src/data/team.ts.
import { siteMeta } from '../../lib/site.ts';
import { team } from '../../data/team.ts';

const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
const abs = (path: string) => new URL(path.replace(/^\//, ''), home).href;

// A team member as a schema.org Person, with their LinkedIn profile if known.
const person = (m: (typeof team)[number]) => ({
  '@type': 'Person',
  name: m.name,
  jobTitle: m.role,
  ...(m.linkedin ? { sameAs: [m.linkedin] } : {}),
});
const isFounder = (m: (typeof team)[number]) => /founder/i.test(m.role);

const organisation = {
  '@type': 'Organization',
  '@id': `${home}#organization`,
  name: siteMeta.name,
  url: home,
  logo: abs(siteMeta.logo),
  image: abs(siteMeta.shareImage.path),
  description: siteMeta.description,
  email: siteMeta.email,
  address: { '@type': 'PostalAddress', ...siteMeta.address },
  founder: team.filter(isFounder).map(person),
  employee: team.filter((m) => !isFounder(m)).map(person),
  ...(siteMeta.sameAs.length ? { sameAs: siteMeta.sameAs } : {}),
};

const website = {
  '@type': 'WebSite',
  '@id': `${home}#website`,
  name: siteMeta.name,
  url: home,
  inLanguage: 'en-GB',
  publisher: { '@id': organisation['@id'] },
};

const schema = { '@context': 'https://schema.org', '@graph': [organisation, website] };
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
