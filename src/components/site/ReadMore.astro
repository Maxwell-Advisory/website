---
// Port of live's `.smooth-readmore`: a visible excerpt, a continuation that is
// collapsed to max-height 0, and a READ MORE toggle. Live's exact values —
// excerpt 20px/25 (18 <=1024, 16 <=767) in #787575; the hidden part animates
// max-height 0.5s ease + opacity 0.4s ease; the button is 14px uppercase with
// 0.5px tracking and fades to 0.6 opacity on hover.
interface Props { visible: string; hidden: string; }
const { visible, hidden } = Astro.props;
---
<div class="readmore" data-readmore>
  <p class="readmore__excerpt">{visible}</p>
  <p class="readmore__excerpt readmore__excerpt--hidden" data-readmore-hidden>{hidden}</p>
  <button class="readmore__btn" type="button" data-readmore-btn aria-expanded="false">READ MORE +</button>
</div>

<style>
  .readmore__excerpt {
    font-size: 20px;
    line-height: 25px;
    color: var(--c-ink-muted);
  }
  @media (max-width: 1024px) { .readmore__excerpt { font-size: 18px; } }
  @media (max-width: 767px)  { .readmore__excerpt { font-size: 16px; } }

  .readmore__excerpt--hidden {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.5s ease, opacity 0.4s ease;
  }
  .readmore.is-open .readmore__excerpt--hidden {
    opacity: 1;
    margin-block-start: 1em;
  }

  .readmore__btn {
    display: inline-block;
    margin-top: 12px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-size: 14px;
    line-height: 21px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    transition: opacity 0.3s ease;
  }
  .readmore__btn:hover { opacity: 0.6; }
</style>

<script>
  // Live sets max-height to the real scrollHeight on open so the reveal is
  // content-sized rather than a fixed guess, and swaps the button label.
  document.querySelectorAll<HTMLElement>('[data-readmore]').forEach((block) => {
    const btn = block.querySelector<HTMLButtonElement>('[data-readmore-btn]');
    const hidden = block.querySelector<HTMLElement>('[data-readmore-hidden]');
    if (!btn || !hidden) return;
    btn.addEventListener('click', () => {
      const open = block.classList.toggle('is-open');
      hidden.style.maxHeight = open ? `${hidden.scrollHeight}px` : '0px';
      btn.textContent = open ? 'READ LESS −' : 'READ MORE +';
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>
