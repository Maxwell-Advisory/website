---
// Port of live's `.typing-target`: the paragraph is emptied and typed back one
// character at a time (10ms apart) once it scrolls 20% into view.
interface Props { text: string; }
const { text } = Astro.props;
---
<p class="type-reveal" data-type-reveal>{text}</p>

<style>
  .type-reveal {
    font-size: var(--fs-intro);   /* live: 36/45 at 1280 */
    line-height: var(--lh-intro);
    color: var(--c-ink-muted);
    text-align: center;
    max-width: 1100px;
    margin-inline: auto;
    min-height: 4em;              /* reserve space so the section does not jump */
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-type-reveal]').forEach((el) => {
    const full = el.textContent || '';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    el.textContent = '';
    let i = 0;
    const type = () => {
      if (i < full.length) { el.textContent += full[i++]; setTimeout(type, 10); }
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { type(); io.disconnect(); }
      });
    }, { threshold: 0.2 });
    io.observe(el);
  });
</script>
