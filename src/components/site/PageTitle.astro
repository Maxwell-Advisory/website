---
// Page title band.
//
// Live puts the page title inside a LILAC band, centred, at the intro type
// scale in #787575 — not a dark heading on white. Measured on /legal-notice/:
// band padding 100px / 70px on #e0e5fc, title 36/32/24px per tier, centred.
interface Props { title: string; }
const { title } = Astro.props;
---
<section class="page-title">
  <h1 class="page-title__text">{title}</h1>
</section>

<style>
  .page-title {
    background: var(--c-lilac);
    padding: 100px var(--container-pad) 70px;
    text-align: center;
  }
  .page-title__text {
    font-size: var(--fs-intro);     /* 36 / 32 / 24 per live's tiers */
    line-height: var(--lh-intro);
    font-weight: var(--fw-book);
    color: var(--c-ink-muted);      /* #787575 */
    max-width: 1100px;              /* live's title widget width */
    margin-inline: auto;
  }
</style>
