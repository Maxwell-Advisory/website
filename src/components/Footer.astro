---
import raw from '../chunks/_footer.html?raw';
const html = raw.replaceAll('__BASE__/', import.meta.env.BASE_URL);
---
<Fragment set:html={html} />
<script>
  // Elementor's own frontend JS never calls Swiper() on the scraped loop-carousel
  // markup (sectors strip, team carousel) — this replicates just that one call.
  //
  // Swiper itself ships as a standalone library in the Elementor asset folder.
  // We load it ourselves (below) rather than waiting for Elementor to inject it,
  // so the carousels no longer depend on the Elementor runtime being present.
  var SWIPER_SRC =
    import.meta.env.BASE_URL +
    'wp-content/plugins/elementor/assets/lib/swiper/v8/swiper.min.js';

  function ensureSwiper(cb) {
    if (typeof window.Swiper === 'function') return cb();
    var existing = document.querySelector('script[data-swiper-lib]');
    if (existing) {
      existing.addEventListener('load', cb);
      return;
    }
    var sc = document.createElement('script');
    sc.src = SWIPER_SRC;
    sc.setAttribute('data-swiper-lib', '');
    sc.addEventListener('load', cb);
    document.head.appendChild(sc);
  }

  function initLoopCarousels() {
    document
      .querySelectorAll('.elementor-widget-loop-carousel .swiper:not(.swiper-initialized)')
      .forEach((el) => {
        const widget = el.closest('[data-widget_type="loop-carousel.post"]');
        let settings = {};
        try {
          settings = JSON.parse((widget && widget.getAttribute('data-settings')) || '{}');
        } catch (e) {
          settings = {};
        }
        new window.Swiper(el, {
          slidesPerView: Number(settings.slides_to_show) || 3,
          spaceBetween: settings.image_spacing_custom?.size ?? 10,
          speed: settings.speed || 500,
          watchOverflow: true,
          pagination:
            settings.pagination === 'progressbar'
              ? { el: el.querySelector('.swiper-pagination'), type: 'progressbar' }
              : false,
          breakpoints: {
            0: { slidesPerView: Number(settings.slides_to_show_mobile) || 1 },
            768: {
              slidesPerView:
                Number(settings.slides_to_show_tablet) || Number(settings.slides_to_show) || 2,
            },
          },
        });
      });
  }
  function boot() {
    ensureSwiper(initLoopCarousels);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
<script>
  // Reveal elements Elementor keeps hidden until its own JS runs. Elementor puts
  // .elementor-invisible { visibility:hidden } on any widget with an entrance
  // animation and only unhides it from frontend.min.js. As that JS is removed
  // (Step E), this shim takes over: strip the class and apply the configured
  // entrance animation (from data-settings) so the logo and popup icons don't
  // stay permanently invisible. Idempotent, so it's harmless while Elementor is
  // still loaded.
  (function () {
    function run() {
      document.querySelectorAll('.elementor-invisible').forEach(function (el) {
        var s = {};
        try {
          s = JSON.parse(el.getAttribute('data-settings') || '{}');
        } catch (e) {
          s = {};
        }
        var reveal = function () {
          el.classList.remove('elementor-invisible');
          if (s._animation) el.classList.add('animated', s._animation);
        };
        if (s._animation_delay) setTimeout(reveal, s._animation_delay);
        else reveal();
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
  })();
</script>
